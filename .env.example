# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # ใช้ฝั่ง server เท่านั้น ห้ามใส่ NEXT_PUBLIC_

# --- LINE Messaging API channel (LINE Developers) ---
LINE_CHANNEL_SECRET=xxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxx

# --- LINE Login channel (สำหรับ LIFF) ---
LINE_LOGIN_CHANNEL_ID=1234567890             # ใช้ตรวจ ID token ฝั่ง server
NEXT_PUBLIC_LIFF_ID=1234567890-AbCdEfGh      # LIFF app ที่ endpoint = https://<โดเมน>/liff

# --- เว็บ ---
NEXT_PUBLIC_BASE_URL=https://backyard-demo.vercel.app
CRON_SECRET=                                 # สุ่มยาว ใช้กับตัวตั้งเวลาที่เรียก /api/cron/welcome ทุก 5 นาที
SESSION_SECRET=                              # สุ่มยาว 32+ ตัว ใช้เซ็นคุกกี้ล็อกอินหลังบ้าน: openssl rand -hex 32

# --- รับเงิน ---
PROMPTPAY_ID=0812345678                      # เบอร์มือถือ หรือเลขบัตร 13 หลัก หรือ e-wallet 15 หลัก
PROMPTPAY_NAME=Backyard Airport

# --- ตรวจสลิป: mock | easyslip | slipok ---
QR_PROVIDER=local                            # local (สร้างเอง ฟรี) | easyslip (ใช้ EasySlip สร้าง QR ไม่กินโควตาตรวจสลิป ถ้าล่มจะสร้างเองแทน)
SLIP_PROVIDER=mock                           # mock (เดโม รับทุกรูป) | easyslip | slipok
EASYSLIP_API_KEY=
EASYSLIP_MATCH_ACCOUNT=false                 # true เมื่อลงทะเบียนบัญชีรับเงินของร้านใน EasySlip แล้ว
SHOP_BANK_ACCOUNT=                           # เลขบัญชีธนาคารของร้าน (ถ้าลูกค้าอาจโอนเข้าบัญชีตรง) ใช้เช็กผู้รับในสลิป
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# --- เดโม: true = เปิดหน้าจองใน browser ได้โดยไม่ต้องอยู่ใน LINE ---
DEMO_MODE=true

# --- เบอร์ร้าน (ขึ้นในข้อความตอบกลับ) ---
SHOP_PHONE=0888101089

# System monitor (หลังบ้าน → สถานะระบบ)
# LINE user ids that get a LINE message when a check turns red (comma separated). Each alert is one push message.
ALERT_LINE_USER_IDS=
# monthly slip checks in your EasySlip plan, and the Supabase database size limit (MB) for the warnings
EASYSLIP_MONTHLY_QUOTA=1000
SUPABASE_DB_LIMIT_MB=500
