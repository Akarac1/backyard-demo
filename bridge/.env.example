# Copy this file to ".env" in the same folder and fill it in. Never share or commit ".env".
SITE_URL=https://YOUR-SITE.vercel.app
LPR_BRIDGE_KEY=                      # same value as LPR_BRIDGE_KEY in Vercel (24+ random characters)
NVR_URL=http://192.168.1.100
NVR_USER=
NVR_PASS=
# NVR_LIST_NAME=TrafficRedList       # change only if `probe` shows a different list name
# POLL_SECONDS=120
# MAX_CHANGES=10                     # safety: refuse a run that changes more rows than this
# MAX_DELETES=5
# VEHICLE_LOOKBACK_MINUTES=180       # how far back to look for vehicle pass-by events on first run
# Barrier open test (paused — this lot's barrier turned out to be wired to its handheld remote
# only, not the NVR's relay outputs, so none of this does anything useful yet; kept for later)
# GATE_POLL_SECONDS=3
# CAM_IN_CHANNEL=0                   # from `node bridge.mjs channels` — confirmed 0=LPR IN, 1=LPR OUT
# CAM_OUT_CHANNEL=1
# Old camera-direct barrier test path (superseded by the NVR-routed one above; camera login
# was never confirmed, so these are unlikely to be needed)
# CAM_IN_URL=http://192.168.1.101
# CAM_OUT_URL=http://192.168.1.102
# CAM_USER=
# CAM_PASS=
